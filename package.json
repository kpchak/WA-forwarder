{
  "name": "whatsapp-forwarder",
  "version": "1.0.0",
  "description": "WhatsApp Web App for QR scanning and message viewing",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=512 server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop wa-forwarder",
    "pm2:restart": "pm2 restart wa-forwarder",
    "pm2:logs": "pm2 logs wa-forwarder",
    "pm2:monit": "pm2 monit",
    "docker:build": "docker compose build || echo 'Docker not available — PM2 deployment, skipping Docker build'",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^164.1.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "github:wwebjs/whatsapp-web.js#58ddf1561cd783d6a548fa812eb70a05944604b4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "keywords": [
    "whatsapp",
    "qr",
    "messaging",
    "web"
  ],
  "author": "",
  "license": "MIT"
}
