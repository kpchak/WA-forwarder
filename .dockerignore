Gsheet/*.json
!Gsheet/credentials.example.json

# Build outputs
dist/
build/

# Git
.git/
.gitignore

# Documentation (optional - remove if you want to include docs)
*.md
!README.md

# Test files (optional)
test/
tests/
__tests__/
*.test.js
*.spec.js


