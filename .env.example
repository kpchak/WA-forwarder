# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTINGER=true

# Optional: create .env.local (gitignored) on your PC — loaded after .env, overrides it.
# Example Windows dev (uncomment and fix path):
# NODE_ENV=development
# HOSTINGER=
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false

# Optional: required on production (HOSTINGER/RAILWAY/NODE_ENV=production) for
# POST /api/whatsapp/clear-session and clear-cache from the home page UI.
# ADMIN_SECRET=your-long-random-string

# ── Puppeteer / Chromium ────────────────────────────────
# Docker/Linux VPS: system Chrome/Chromium path. On Windows localhost, either omit
# PUPPETEER_EXECUTABLE_PATH or use e.g. C:\Program Files\Google\Chrome\Application\chrome.exe
# (the server ignores the path if the file does not exist and falls back to bundled Chromium).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# Local dev on Windows: often use false so Puppeteer can download/use bundled Chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# Max old-space for the Chromium subprocess (MB)
CHROMIUM_MAX_OLD_SPACE=256

# whatsapp-web.js: pinned WhatsApp Web HTML (see wppconnect-team/wa-version html/*.html)
# WWEBJS_WEB_VERSION=2.3000.1036930770-alpha

# ── Google Sheets (optional – for customer groups) ──────
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
