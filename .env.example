# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTINGER=true

# ── Puppeteer / Chromium ────────────────────────────────
# Path to system-installed Chromium (set by setup.sh)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# Max old-space for the Chromium subprocess (MB)
CHROMIUM_MAX_OLD_SPACE=256

# whatsapp-web.js: pinned WhatsApp Web HTML (see wppconnect-team/wa-version html/*.html)
# WWEBJS_WEB_VERSION=2.3000.1036930770-alpha

# ── Google Sheets (optional – for customer groups) ──────
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
